# =========================================================
# Byte Operator - Environment Configuration
# =========================================================

# Primary Lead Notification Email (Default: samiullah@byteoperator.com)
NOTIFICATION_EMAIL=samiullah@byteoperator.com

# ---------------------------------------------------------
# OPTION 1: Resend (Recommended for Next.js)
# Sign up at https://resend.com to get an API key
# ---------------------------------------------------------
# RESEND_API_KEY=re_1234567890
# RESEND_FROM_EMAIL=Byte Operator <onboarding@resend.dev>

# ---------------------------------------------------------
# OPTION 2: SendGrid
# ---------------------------------------------------------
# SENDGRID_API_KEY=SG.1234567890
# SENDGRID_FROM_EMAIL=notifications@byteoperator.com

# ---------------------------------------------------------
# OPTION 3: Webhook Relay (Discord, Slack, Zapier, Make, n8n)
# ---------------------------------------------------------
# NOTIFICATION_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
